views:
  - type: table
    name: Table
    filters:
      and:
        - file.path.contains("26 Traffic Offences")
        - file.ext != "base"
        - file.name != "26.00 Traffic Offences"
    order:
      - file.name
      - jurisdiction
      - offence type
      - act
      - section
      - penalty
      - fine
      - demerits
    columnSize:
      file.name: 311
      note.jurisdiction: 143
      note.offence type: 97
      note.act: 96
      note.penalty: 154
