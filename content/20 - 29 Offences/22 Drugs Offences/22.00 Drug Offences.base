views:
  - type: table
    name: Table
    filters:
      and:
        - file.ext != "base"
        - file.path.contains("22 Drugs Offences")
        - '!file.name.contains("22.00")'
    order:
      - file.name
      - offence type
      - jurisdiction
      - act
      - section
      - penalty
    columnSize:
      note.jurisdiction: 159
      note.act: 142
      note.penalty: 251
